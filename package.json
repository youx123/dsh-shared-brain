{
  "name": "dsh-shared-brain",
  "version": "0.8.0",
  "description": "让人设与记忆在所有会话之间共享，并按认知/底线/情感/本能/声音分层加权",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "memory",
    "shared-brain",
    "modules",
    "voice"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youx123/dsh-shared-brain.git"
  },
  "homepage": "https://github.com/youx123/dsh-shared-brain#readme",
  "bugs": {
    "url": "https://github.com/youx123/dsh-shared-brain/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
